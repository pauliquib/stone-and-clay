[ext_resource type="Script" path="res://scripts/ai/actions/random_walk.gd" id="9_44c68"]

[sub_resource type="BTCondition" id="BTCondition_f5jjb"]
custom_name = "Je 6–8 h?"
script = ExtResource("1_8wkxd")
hour_from = 6.0
hour_to = 8.0

[sub_resource type="BTAction" id="BTAction_cyhkt"]
custom_name = "Jdi na zahradu"
script = ExtResource("2_8in0b")
place_var = "garden"
arrive = 1.8

[sub_resource type="BTAction" id="BTAction_qv46v"]
custom_name = "Kope na zahradě"
script = ExtResource("3_ir1jn")
anim = "dig"
pose = ""
duration = 20.0
promile_gain = 0.0

[sub_resource type="BTSequence" id="BTSequence_453fw"]
custom_name = "Ranní rutina"
children = [SubResource("BTCondition_f5jjb"), SubResource("BTAction_cyhkt"), SubResource("BTAction_qv46v")]

[sub_resource type="BTCondition" id="BTCondition_3iij0"]
custom_name = "Je pracovní den?"
script = ExtResource("4_ne86n")

[sub_resource type="BTCondition" id="BTCondition_twc46"]
custom_name = "Má zaměstnání?"
script = ExtResource("5_5kohf")
place_var = "workplace"

[sub_resource type="BTCondition" id="BTCondition_lwnjp"]
custom_name = "Je 6:30–16:00?"
script = ExtResource("1_8wkxd")
hour_from = 6.5
hour_to = 16.0

[sub_resource type="BTAction" id="BTAction_d7y7b"]
