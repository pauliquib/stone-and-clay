[resource]
description = "Denní rutina vesničana (Fáze 3): ráno zahrada, přes den práce, v pá/so večer hospoda, jinak procházka po cestách. Cíle plní Villager do blackboardu."
root_task = SubResource("BTSelector_x6ftb")
