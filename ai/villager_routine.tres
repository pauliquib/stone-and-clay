[sub_resource type="BTSequence" id="BTSequence_3fjr8"]
custom_name = "Práce"
children = [SubResource("BTCondition_3iij0"), SubResource("BTCondition_twc46"), SubResource("BTCondition_lwnjp"), SubResource("BTAction_d7y7b"), SubResource("BTAction_pbind")]

[sub_resource type="BTCondition" id="BTCondition_lbmkq"]
custom_name = "Je pá/so večer?"
script = ExtResource("7_gmsph")
days = Array[int]([4, 5])
hour_from = 17.0
hour_to = 24.0

[sub_resource type="BTCondition" id="BTCondition_4a5pc"]
custom_name = "Promile < 0,5 ‰?"
script = ExtResource("8_42ppu")
limit = 0.5

[sub_resource type="BTAction" id="BTAction_t3m71"]
custom_name = "Jdi ke stolu u hospody"
