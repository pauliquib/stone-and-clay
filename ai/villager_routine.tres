[resource]
description = "Denní rutina vesničana (Fáze 3): ráno zahrada (za vhodného počasí), přes den práce (je-li místo otevřeno), o víkendu nákup, v pá/so večer hospoda, jinak procházka po cestách. Cíle plní Villager do blackboardu."
root_task = SubResource("BTSelector_wx4hh")
