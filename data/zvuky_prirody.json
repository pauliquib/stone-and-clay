  "_popis": "M8.18 Zvuková krajina (scripts/priroda/soundscape.gd): zdroje zvuků přírody. Zvuky jsou procedurální (NatureSfx.synth), žádné nahrávky. Ladí se v F3 → Příroda/Zvuková krajina – druhy.",
  "_klice": {
    "zvuk": "jméno zvuku v NatureSfx (synth nebo starý get_stream: blackbird, crow, buzzard)",
    "typ": "vola = opakované volání po intervalu; smycka = smyčka (skřivan, bzučení, komáři); cvrcek = rychlost podle Dolbearova zákona (cvrknutí/min = A·T − B, × dolbear)",
    "mesice": "aktivita v měsících leden…prosinec (0..1)",
    "okna": "[kotva, od, do, váha]: kotva v = minuty od východu slunce, z = minuty od západu, h = hodiny místního času (do > 24 = po půlnoci)",
    "stanoviste": "vhodnost buňky 40 m: les, okraj (lesa), louka, pole, obec, voda (tok i nádrž), nadrz (rybník, tůň), niva (lužní les v nivě)",
    "hustota": "pravděpodobnost teritoria ve vhodné buňce (× vhodnost)",
    "hlasitost": "dB u zdroje (útlum vzdáleností řeší AudioStreamPlayer3D, unit_size = Soundscape.UNIT_SIZE)",
    "dosah": "m – dál se zdroj nevybírá",
    "interval": "s mezi voláními [od, do] (při nižší aktivitě delší)",
    "vyska": "m nad zemí [od, do]",
    "ladeni": "výška tónu teritoria [od, do] (×)",
    "t_min / t_plne": "°C (Microclimate.temp_at u posluchače): pod t_min ticho, od t_plne plná aktivita",
    "dest": "útlum deštěm 0..1 (1 = v silném dešti úplně ticho)",
    "vitr": "m/s – při tomto větru už ticho",
    "domy": "zdroj jen u domácností (M8.17): pes / slepice (kohout)",
    "kvet": "aktivita × kvetení louky (Seasons.bloom / Phenology.bees_bloom)",
    "denik": "první uslyšení do deníku pozorování (J)"
  },
