; Engine configuration file.
config_version=5

[application]

config/name="Stone & Clay"
config/version="0.1.0"
config/description="Hra na mapě celého katastru obce Dukelčic (geodata ČÚZK + OSM)."
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.3", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("func_godot", "godot_state_charts")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=2

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=20.0
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.62, 0.74, 0.88, 1)

